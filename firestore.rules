rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Config and dynamic download counters:
    match /config/downloads {
      allow read: if true;
      allow create, update: if true;
    }

    // Download events log for tracking downloads in Firebase Console:
    match /download_events/{id} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    // Bug Reports: users can submit bug reports directly
    match /bug_reports/{id} {
      allow create: if true;
      allow read, update, delete: if false; // Viewable in Firebase Console
    }

    // User Reviews: users can submit reviews
    match /reviews/{id} {
      allow create: if true;
      allow read: if true;
      allow update, delete: if false;
    }

    // Default rule for other documents
    match /{document=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
